{%- comment -%}
  Advent: What's inside · Twelve Days of Framar advent calendar.
  Two photos (open box + a smaller overlapping one), heading, text, key facts (blocks) and a note. No JavaScript.
  On tablet and phone the heading comes first, then the photo, then the rest.
{%- endcomment -%}

{%- comment -%} Loaded once in <head> on the advent-calendar template; anywhere else the section loads it itself. {%- endcomment -%}
{%- unless template.suffix == 'advent-calendar' -%}
  {% render 'advent-assets' %}
{%- endunless -%}

{%- assign sid = '#shopify-section-' | append: section.id -%}
{% style %}
  {{ sid }} .adv-inside {
    --inside-bg: {{ section.settings.background_color | default: '#FBE9E8' }};
    --inside-heading: {{ section.settings.heading_color | default: '#1F3A2C' }};
    --inside-text: {{ section.settings.text_color | default: '#4A5D50' }};
    --inside-accent: {{ section.settings.accent_color | default: '#A8192A' }};
    --inside-frame: {{ section.settings.frame_color | default: '#FFFFFF' }};
  }
{% endstyle %}

<div class="adv">
  <section id="whats-inside" class="adv-section adv-inside">
    <div class="adv-wrap adv-inside__grid">
      {%- liquid
        assign main_class = 'adv-inside__img adv-inside__img--' | append: section.settings.image_shape
        assign small_class = 'adv-inside__img adv-inside__img--small adv-inside__img--' | append: section.settings.image_2_shape
      -%}
      <div class="adv-inside__media{% if section.settings.show_image_2 %} adv-inside__media--pair{% endif %}">
        {% render 'advent-image',
          image: section.settings.image,
          class: main_class, sizes: '(min-width: 1094px) 460px, (min-width: 700px) 430px, 80vw'
        %}
        {%- if section.settings.show_image_2 -%}
          {% render 'advent-image',
            image: section.settings.image_2,
            class: small_class, sizes: '(min-width: 1094px) 250px, (min-width: 700px) 240px, 45vw'
          %}
        {%- endif -%}
      </div>

      <div class="adv-inside__copy">
        {%- if section.settings.eyebrow != blank -%}
          <span class="adv-eyebrow adv-inside__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2 class="adv-h2 adv-inside__heading">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <div class="adv-inside__text">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="adv-inside__facts">
            {%- for block in section.blocks -%}
              {%- assign fact_icon = block.settings.icon | default: 'none' -%}
              <li class="adv-inside__fact{% if fact_icon != 'none' %} adv-inside__fact--icon{% endif %}" {{ block.shopify_attributes }}>
                {%- if fact_icon != 'none' -%}
                  <span class="adv-inside__fact-icon">{% render 'advent-icon', icon: fact_icon, size: 20 %}</span>
                {%- endif -%}
                <span class="adv-inside__fact-value">{{ block.settings.value }}</span>
                <span class="adv-inside__fact-label">{{ block.settings.label }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.note != blank -%}
          <p class="adv-inside__note">
            {% render 'advent-icon', icon: 'sparkle', size: 16, fill: 'currentColor' %}
            <span>{{ section.settings.note }}</span>
          </p>
        {%- endif -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Advent: What's inside",
  "tag": "div",
  "class": "section-advent-inside",
  "settings": [
    {
      "type": "header",
      "content": "Photos"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main photo",
      "info": "The open box. Shown uncropped unless you pick a shape below."
    },
    {
      "type": "select",
      "id": "image_shape",
      "label": "Main photo shape",
      "default": "original",
      "options": [
        {
          "value": "original",
          "label": "Original (no crop)"
        },
        {
          "value": "landscape",
          "label": "Landscape 5:4"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait 4:5"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_image_2",
      "label": "Show second photo",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Second photo",
      "info": "Smaller photo overlapping the corner, e.g. the closed box."
    },
    {
      "type": "select",
      "id": "image_2_shape",
      "label": "Second photo shape",
      "default": "original",
      "options": [
        {
          "value": "original",
          "label": "Original (no crop)"
        },
        {
          "value": "landscape",
          "label": "Landscape 5:4"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait 4:5"
        }
      ]
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "Lorem ipsum dolor"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Lorem ipsum"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Lorem ipsum dolor sit amet consectetur adipiscing elit sed do eiusmod tempor incididunt ut labore et dolore magna aliqua ut enim ad minim veniam quis nostrud.</p>"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note",
      "info": "Leave empty to hide.",
      "default": "Lorem ipsum dolor sit amet consectetur adipiscing elit sed do eiusmod."
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FBE9E8"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#1F3A2C"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#4A5D50"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Small heading, numbers and lines",
      "default": "#A8192A"
    },
    {
      "type": "color",
      "id": "frame_color",
      "label": "Photo border",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Fact",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "step-gift",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "step-gift",
              "label": "Gift"
            },
            {
              "value": "step-layers",
              "label": "Stack of sheets"
            },
            {
              "value": "step-ruler",
              "label": "Ruler"
            },
            {
              "value": "step-calendar",
              "label": "Calendar"
            },
            {
              "value": "step-door",
              "label": "Drawer / door"
            },
            {
              "value": "step-sparkle",
              "label": "Sparkle"
            },
            {
              "value": "step-bag",
              "label": "Shopping bag"
            },
            {
              "value": "step-truck",
              "label": "Delivery truck"
            }
          ]
        },
        {
          "type": "text",
          "id": "value",
          "label": "Number or value",
          "default": "Lorem"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Lorem ipsum dolor"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Advent: What's inside",
      "blocks": [
        {
          "type": "fact",
          "settings": {
            "value": "Lorem",
            "label": "Lorem ipsum dolor",
            "icon": "step-gift"
          }
        },
        {
          "type": "fact",
          "settings": {
            "value": "Lorem",
            "label": "Lorem ipsum dolor sit",
            "icon": "step-layers"
          }
        },
        {
          "type": "fact",
          "settings": {
            "value": "Lorem",
            "label": "Lorem ipsum",
            "icon": "step-ruler"
          }
        }
      ]
    }
  ]
}
{% endschema %}
