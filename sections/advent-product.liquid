{%- comment -%}
  Advent: Product · Twelve Days of Framar advent calendar.
  For product templates: title, photos, price, SKU, stock and description come from the product.
  Standalone section; shares assets/advent-calendar.css and .js with the other Advent sections.
{%- endcomment -%}

{%- comment -%} Loaded once in <head> on the advent-calendar template; anywhere else the section loads it itself. {%- endcomment -%}
{%- unless template.suffix == 'advent-calendar' -%}
  {% render 'advent-assets' %}
{%- endunless -%}

{%- comment -%} Everything here comes from the product of the page (product templates). {%- endcomment -%}
{%- liquid
  assign adv_product = product
  assign variant = product.selected_or_first_available_variant
  assign price_cents = variant.price
  assign price_label = variant.price | money
-%}
{%- liquid
  assign accordions = section.blocks | where: 'type', 'accordion'
-%}

{%- assign sid = '#shopify-section-' | append: section.id -%}
{% style %}
  {{ sid }} .adv-product { background: {{ section.settings.background_color | default: '#FFFDF9' }}; }
  {{ sid }} .adv-buy__title { color: {{ section.settings.title_color | default: '#1F3A2C' }}; }
  {{ sid }} .adv-buy__vendor, {{ sid }} .adv-buy__subtitle { color: {{ section.settings.accent_color | default: '#A8192A' }}; }
  {{ sid }} .adv-buy__desc { color: {{ section.settings.text_color | default: '#4A5D50' }}; }
  {{ sid }} .adv-gallery__badge { background: {{ section.settings.badge_color | default: '#A8192A' }}; color: {{ section.settings.badge_text_color | default: '#FFFFFF' }}; }
{% endstyle %}

<advent-calendar class="adv" data-money-format="{{ shop.money_format | strip_html | escape }}">
<section id="product" class="adv-section adv-product">
  <div class="adv-wrap adv-product__grid">
    <div class="adv-gallery">
      {%- liquid
        assign media_images = adv_product.media | where: 'media_type', 'image'
      -%}
      <div class="adv-gallery__main">
        {%- if media_images.size > 0 -%}
          {% render 'advent-image', image: media_images.first.preview_image,
            sizes: '(min-width: 1320px) 640px, (min-width: 750px) 50vw, 100vw', loading: 'eager', attrs: 'data-gallery-main'
          %}
        {%- else -%}
          {% render 'advent-image' %}
        {%- endif -%}
        {%- if section.settings.gallery_badge != blank -%}
          <span class="adv-gallery__badge">{{ section.settings.gallery_badge }}</span>
        {%- endif -%}
      </div>

      {%- if media_images.size > 1 -%}
        <div class="adv-gallery__thumbs">
          {%- for m in media_images limit: 10 -%}
            {%- assign img = m.preview_image -%}
            <button type="button" class="adv-thumb" data-gallery-thumb
              aria-label="{{ 'products.product.media.load_image' | t: index: forloop.index }}"
              aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
              data-src="{{ img | image_url: width: 1200 }}"
              data-srcset="{{ img | image_url: width: 720 }} 720w, {{ img | image_url: width: 1200 }} 1200w, {{ img | image_url: width: 1600 }} 1600w"
              data-alt="{{ m.alt | escape }}">
              {{ img | image_url: width: 240 | image_tag: alt: '', loading: 'lazy' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="adv-buy">
      <div class="adv-buy__titles">
        {%- if section.settings.brand_label != blank -%}
          <span class="adv-buy__vendor">{{ section.settings.brand_label }}</span>
        {%- endif -%}
        <h2 class="adv-buy__title">{{ adv_product.title }}</h2>
        {%- if section.settings.buy_subtitle != blank -%}
          <span class="adv-buy__subtitle">{{ section.settings.buy_subtitle }}</span>
        {%- endif -%}
        {%- if variant.sku != blank -%}<span class="adv-buy__sku">{{ 'products.product.sku' | t }}: {{ variant.sku }}</span>{%- endif -%}
      </div>

      <div class="adv-buy__price-row">
        <span class="adv-buy__price">
          {{ price_label }}
          {%- if variant.compare_at_price > variant.price -%}
            <s class="adv-buy__compare"><span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>{{ variant.compare_at_price | money }}</s>
          {%- endif -%}
        </span>
        {%- if variant.available -%}
          <span class="adv-buy__stock">{{ section.settings.stock_label }}</span>
        {%- else -%}
          <span class="adv-buy__stock adv-buy__stock--out">{{ section.settings.sold_out_label }}</span>
        {%- endif -%}
      </div>


      {%- if adv_product.description != blank -%}
        <div class="adv-buy__desc">{{ adv_product.description }}</div>
      {%- endif -%}

      {%- comment -%} Highlights above the add to cart: icon, main line and a short line, stacked with thin dividers. {%- endcomment -%}
      <div class="adv-facts">
        {%- for i in (1..3) -%}
          {%- liquid
            assign label_key = 'fact_' | append: i | append: '_label'
            assign value_key = 'fact_' | append: i | append: '_value'
            assign icon_key = 'fact_' | append: i | append: '_icon'
            assign fact_label = section.settings[label_key]
            assign fact_value = section.settings[value_key]
            assign fact_icon = section.settings[icon_key]
          -%}
          {%- if fact_label != blank or fact_value != blank -%}
            <div class="adv-fact">
              {%- if fact_icon != 'none' -%}
                <span class="adv-fact__icon">{% render 'advent-icon', icon: fact_icon, size: 22 %}</span>
              {%- endif -%}
              <span class="adv-fact__value">{{ fact_value }}</span>
              <span class="adv-fact__label">{{ fact_label }}</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if adv_product != blank -%}
        {%- capture cart_prefix -%}{{ section.settings.cart_label }}{%- endcapture -%}
        {%- form 'product', adv_product, class: 'adv-form', data-advent-cart: 'true', data-added-label: section.settings.added_label -%}
          <input type="hidden" name="id" value="{{ variant.id }}">
          <div class="adv-qty">
            <button type="button" aria-label="{{ 'products.product.quantity.decrease' | t: product: adv_product.title | escape }}" data-qty-dec>&minus;</button>
            <label class="visually-hidden" for="AdvQty-{{ section.id }}">{{ 'products.product.quantity.label' | t }}</label>
            <input id="AdvQty-{{ section.id }}" type="number" name="quantity" value="1" min="1" max="10" inputmode="numeric" data-qty-input>
            <button type="button" aria-label="{{ 'products.product.quantity.increase' | t: product: adv_product.title | escape }}" data-qty-inc>+</button>
          </div>
          <button type="submit" class="adv-form__submit" {% unless variant.available %}disabled{% endunless %}>
            <span data-cart-label data-prefix="{{ cart_prefix | escape }}" data-unit-price="{{ price_cents }}">
              {%- if variant.available -%}{{ cart_prefix }} · {{ price_label }}{%- else -%}{{ section.settings.sold_out_label }}{%- endif -%}
            </span>
          </button>
          <p class="adv-form__error" role="alert" data-cart-error hidden></p>
        {%- endform -%}
      {%- endif -%}

      {%- if section.settings.ship_cutoff != blank -%}
        <div class="adv-ship">
          {% render 'advent-icon', icon: 'truck' %}
          <div class="adv-ship__text">
            <strong>{{ section.settings.ship_title }}</strong>
            {{ section.settings.ship_before }} <strong data-ship-countdown data-cutoff="{{ section.settings.ship_cutoff | escape }}">{{ section.settings.ship_fallback }}</strong> {{ section.settings.ship_after }}
          </div>
        </div>
      {%- endif -%}

      {%- if accordions.size > 0 -%}
        <div class="adv-acc">
          {%- for block in accordions -%}
            <details {{ block.shopify_attributes }}>
              <summary>{{ block.settings.title }}</summary>
              <div class="adv-acc__body">{{ block.settings.body }}</div>
            </details>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
</advent-calendar>

