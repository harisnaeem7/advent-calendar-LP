{%- comment -%}
  Advent: Loved by stylists · Twelve Days of Framar advent calendar.
  Centred heading + review cards (blocks): stars, quote, photo or initials, name and Instagram handle. No JavaScript.
{%- endcomment -%}

{%- comment -%} Loaded once in <head> on the advent-calendar template; anywhere else the section loads it itself. {%- endcomment -%}
{%- unless template.suffix == 'advent-calendar' -%}
  {% render 'advent-assets' %}
{%- endunless -%}

{%- assign sid = '#shopify-section-' | append: section.id -%}
{% style %}
  {{ sid }} .adv-reviews {
    --rev-bg: {{ section.settings.background_color | default: '#FFF8F5' }};
    --rev-heading: {{ section.settings.heading_color | default: '#1F3A2C' }};
    --rev-text: {{ section.settings.text_color | default: '#4A5D50' }};
    --rev-accent: {{ section.settings.accent_color | default: '#A8192A' }};
    --rev-card: {{ section.settings.card_color | default: '#FFFFFF' }};
    --rev-highlight: {{ section.settings.highlight_color | default: '#FBE9E8' }};
    --rev-star: {{ section.settings.star_color | default: '#D9A46E' }};
  }
{% endstyle %}

<div class="adv">
  <section id="reviews" class="adv-section adv-reviews">
    <div class="adv-wrap--narrow adv-reviews__wrap">
      <div class="adv-heading-center">
        {%- if section.settings.reviews_eyebrow != blank -%}
          <span class="adv-eyebrow adv-reviews__eyebrow">{{ section.settings.reviews_eyebrow }}</span>
        {%- endif -%}
        <h2 class="adv-h2 adv-reviews__heading">{{ section.settings.reviews_heading }}</h2>
        {%- if section.settings.reviews_text != blank -%}
          <p class="adv-reviews__text">{{ section.settings.reviews_text }}</p>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <ul class="adv-quotes" role="list">
          {%- for block in section.blocks -%}
            <li class="adv-quote{% if block.settings.featured %} adv-quote--featured{% endif %}" {{ block.shopify_attributes }}>
              <figure class="adv-quote__inner">
                {%- if section.settings.show_stars -%}
                  {%- assign rating = block.settings.rating | default: 5 -%}
                  <div class="adv-quote__stars" role="img" aria-label="{{ rating }} out of 5 stars">
                    {%- for i in (1..5) -%}
                      <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" focusable="false"{% if i > rating %} class="is-empty"{% endif %}><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z"></path></svg>
                    {%- endfor -%}
                  </div>
                {%- endif -%}
                <blockquote class="adv-quote__text">{{ block.settings.quote }}</blockquote>
                <figcaption class="adv-quote__by">
                  {%- if block.settings.photo != blank -%}
                    {{ block.settings.photo | image_url: width: 96 | image_tag: class: 'adv-quote__avatar', width: 44, height: 44, loading: 'lazy', alt: block.settings.name }}
                  {%- elsif block.settings.initials != blank -%}
                    <span class="adv-quote__avatar adv-quote__avatar--initials" aria-hidden="true">{{ block.settings.initials }}</span>
                  {%- endif -%}
                  <span class="adv-quote__who">
                    <span class="adv-quote__name">{{ block.settings.name }}</span>
                    {%- if block.settings.handle != blank -%}
                      {%- if block.settings.url != blank -%}
                        <a class="adv-quote__handle" href="{{ block.settings.url }}" target="_blank" rel="noopener">{% render 'advent-icon', icon: 'instagram' %}{{ block.settings.handle }}</a>
                      {%- else -%}
                        <span class="adv-quote__handle">{% render 'advent-icon', icon: 'instagram' %}{{ block.settings.handle }}</span>
                      {%- endif -%}
                    {%- endif -%}
                  </span>
                </figcaption>
              </figure>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </section>
</div>

