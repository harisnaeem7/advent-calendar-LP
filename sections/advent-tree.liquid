    </div>
  </div>
</section>
</advent-calendar>

{% schema %}
{
  "name": "Advent: Under the tree",
  "tag": "div",
  "class": "section-advent-tree",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Leave empty on a product template to use that product."
    },
    {
      "type": "text",
      "id": "placeholder_price",
      "label": "Price shown when no product is set",
      "default": "Lorem"
    },
    {
      "type": "text",
      "id": "tree_eyebrow",
      "label": "Eyebrow",
      "default": "Lorem ipsum dolor"
    },
    {
      "type": "text",
      "id": "tree_heading",
      "label": "Heading",
      "default": "Lorem ipsum dolor sit amet consectetur."
    },
    {
      "type": "textarea",
      "id": "tree_text",
      "label": "Text",
      "default": "Lorem ipsum dolor sit amet consectetur adipiscing elit sed do eiusmod tempor incididunt ut labore et dolore magna aliqua ut enim ad minim veniam quis nostrud."
    },
    {
      "type": "text",
      "id": "tree_note",
      "label": "Note",
      "default": "Lorem ipsum dolor sit amet consectetur adipiscing elit sed do eiusmod."
    },
    {
      "type": "text",
      "id": "tree_cta",
      "label": "Button label",
      "info": "The price is added after it.",
      "default": "Lorem ipsum dolor"
    },
    {
      "type": "header",
      "content": "Ornament photos"
    },
    {
      "type": "image_picker",
      "id": "tree_ornament_1",
      "label": "Ornament 1"
    },
    {
      "type": "image_picker",
      "id": "tree_ornament_2",
      "label": "Ornament 2"
    },
    {
      "type": "image_picker",
      "id": "tree_ornament_3",
      "label": "Ornament 3"
    },
    {
      "type": "image_picker",
      "id": "tree_ornament_4",
      "label": "Ornament 4"
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "grass_color",
      "label": "Grass",
      "default": "#4F7F55"
    }
  ],
  "presets": [
    {
      "name": "Advent: Under the tree"
    }
  ]
}
{% endschema %}
