{%- comment -%}
  Advent: Videos · Twelve Days of Framar advent calendar.
  Centred heading with an optional divider, then a row of tap-to-play videos (muted).
  Standalone section; shares assets/advent-calendar.css and .js with the other Advent sections.
{%- endcomment -%}

{%- comment -%} Loaded once in <head> on the advent-calendar template; anywhere else the section loads it itself. {%- endcomment -%}
{%- unless template.suffix == 'advent-calendar' -%}
  {% render 'advent-assets' %}
{%- endunless -%}

{%- liquid
  assign videos = section.blocks | where: 'type', 'video'
-%}

{% style %}
  #shopify-section-{{ section.id }} .adv-videos {
    --vid-bg: {{ section.settings.background_color | default: '#1F3A2C' }};
    --vid-heading: {{ section.settings.heading_color | default: '#F7F3EC' }};
    --vid-text: {{ section.settings.text_color | default: '#DCE6DC' }};
    --vid-accent: {{ section.settings.accent_color | default: '#D9A46E' }};
    --vid-frame: {{ section.settings.frame_color | default: '#F0E6DA' }};
  }
{% endstyle %}

<advent-calendar class="adv">
{%- if videos.size > 0 -%}
  <section id="videos" class="adv-section adv-videos">
    <div class="adv-wrap adv-videos__wrap">
      <div class="adv-videos__head">
        {%- if section.settings.videos_eyebrow != blank -%}
          <span class="adv-eyebrow adv-videos__eyebrow">{{ section.settings.videos_eyebrow }}</span>
        {%- endif -%}
        <h2 class="adv-h2 adv-videos__heading">{{ section.settings.videos_heading }}</h2>
        {%- case section.settings.divider -%}
          {%- when 'sparkle' -%}
            <span class="adv-divider adv-divider--sparkle" aria-hidden="true">{% render 'advent-icon', icon: 'sparkle', size: 14 %}</span>
          {%- when 'line' -%}
            <span class="adv-divider" aria-hidden="true"></span>
        {%- endcase -%}
        {%- if section.settings.videos_text != blank -%}
          <p class="adv-videos__text">{{ section.settings.videos_text }}</p>
        {%- endif -%}
      </div>
      <div class="adv-videos__track" data-drag-scroll>
        {%- for block in videos -%}
          {%- liquid
            assign r3 = forloop.index0 | modulo: 3
            case r3
              when 0
                assign rot = '-1.5deg'
              when 1
                assign rot = '1deg'
              else
                assign rot = '-1deg'
            endcase
            assign video_src = ''
            if block.settings.video != blank
              assign mp4 = block.settings.video.sources | where: 'mime_type', 'video/mp4' | first
              assign video_src = mp4.url | default: block.settings.video.sources.first.url
            elsif block.settings.video_url != blank
              assign video_src = block.settings.video_url
            endif
            assign poster = block.settings.poster | default: block.settings.video.preview_image
          -%}
          <div class="adv-video" style="--rot: {{ rot }};"{% if video_src != blank %} data-video-src="{{ video_src }}"{% endif %} {{ block.shopify_attributes }}>
            {% render 'advent-image', image: poster, sizes: '(min-width: 750px) 33vw, 74vw' %}
            {%- if video_src != blank -%}
              {%- assign play_label = 'products.product.media.play_video' | t -%}
              <button type="button" class="adv-video__trigger" aria-label="{{ block.settings.label | default: play_label | escape }}">
                <span class="adv-video__play" aria-hidden="true">{% render 'advent-icon', icon: 'play' %}</span>
              </button>
            {%- else -%}
              <span class="adv-video__play" aria-hidden="true">{% render 'advent-icon', icon: 'play' %}</span>
            {%- endif -%}
            {%- if block.settings.label != blank -%}
              <span class="adv-video__label">{{ block.settings.label }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}
</advent-calendar>

{% schema %}
{
  "name": "Advent: Videos",
  "tag": "div",
  "class": "section-advent-videos",
  "settings": [
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "videos_eyebrow",
      "label": "Small heading",
      "info": "Leave empty to hide.",
      "default": "Lorem ipsum dolor"
    },
    {
      "type": "text",
      "id": "videos_heading",
      "label": "Heading",
      "default": "Lorem ipsum dolor sit"
    },
    {
      "type": "select",
      "id": "divider",
      "label": "Divider under heading",
      "default": "sparkle",
      "options": [
        {
          "value": "sparkle",
          "label": "Line with sparkle"
        },
        {
          "value": "line",
          "label": "Short line"
        },
        {
          "value": "none",
          "label": "None"
        }
      ]
    },
    {
      "type": "textarea",
      "id": "videos_text",
      "label": "Text",
      "default": "Lorem ipsum dolor sit amet consectetur adipiscing elit sed.",
      "info": "Leave empty to hide."
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#1F3A2C"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#F7F3EC"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#DCE6DC"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Small heading and divider",
      "default": "#D9A46E"
    },
    {
      "type": "color",
      "id": "frame_color",
      "label": "Video border",
      "default": "#F0E6DA"
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label (optional)",
          "info": "Small tag on the video. Leave empty to hide."
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video (uploaded)"
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "Or video file URL (.mp4)"
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "Poster image",
          "info": "Portrait 9:14."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Advent: Videos",
      "blocks": [
        {
          "type": "video",
          "settings": {}
        },
        {
          "type": "video",
          "settings": {}
        },
        {
          "type": "video",
          "settings": {}
        }
      ]
    }
  ]
}
{% endschema %}
