{%- comment -%}
  Small inline SVGs used by the Advent Calendar section.
  Usage: {% render 'advent-icon', icon: 'sparkle', size: 18, fill: '#D9A46E' %}
{%- endcomment -%}
{%- liquid
  assign s = size | default: 24
  assign f = fill | default: 'currentColor'
-%}
{%- case icon -%}
  {%- when 'sparkle' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 0Q13.6 10.4 24 12Q13.6 13.6 12 24Q10.4 13.6 0 12Q10.4 10.4 12 0Z" fill="{{ f }}"></path></svg>
  {%- when 'calendar' -%}
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.8" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M3 10h18M8 3v4M16 3v4"></path></svg>
  {%- when 'truck' -%}
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#1F3A2C" stroke-width="1.8" aria-hidden="true" focusable="false"><path d="M1 6h13v10H1zM14 10h5l3 3v3h-8z"></path><circle cx="5" cy="18" r="2"></circle><circle cx="18" cy="18" r="2"></circle></svg>
  {%- when 'instagram' -%}
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle></svg>
  {%- when 'play' -%}
    <svg width="30" height="30" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 4.5v15a.75.75 0 0 0 1.14.64l12.3-7.5a.75.75 0 0 0 0-1.28L8.14 3.86A.75.75 0 0 0 7 4.5z" fill="currentColor"></path></svg>
  {%- comment -%} Step icons: outline, take the text colour (currentColor) {%- endcomment -%}
  {%- when 'step-bag' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 8h14l-1.2 12.2a1 1 0 0 1-1 .8H7.2a1 1 0 0 1-1-.8z"></path><path d="M9 10V6.5a3 3 0 0 1 6 0V10"></path></svg>
  {%- when 'step-gift' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3.5" y="9" width="17" height="11.5" rx="1"></rect><path d="M2.5 9h19M12 9v11.5"></path><path d="M12 9C10 5 6.5 5 6.5 7.2S12 9 12 9zm0 0c2-4 5.5-4 5.5-1.8S12 9 12 9z"></path></svg>
  {%- when 'step-door' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="4" y="3" width="16" height="18" rx="1.5"></rect><path d="M4 12h16M12 3v18"></path><circle cx="10" cy="8" r=".7" fill="currentColor"></circle><circle cx="14" cy="16.5" r=".7" fill="currentColor"></circle></svg>
  {%- when 'step-calendar' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3.5" y="5" width="17" height="15.5" rx="2"></rect><path d="M3.5 10h17M8 3v4M16 3v4"></path><path d="M8 14h2M14 14h2M8 17h2"></path></svg>
  {%- when 'step-sparkle' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M11 3Q12.2 10.8 20 12Q12.2 13.2 11 21Q9.8 13.2 2 12Q9.8 10.8 11 3Z"></path><path d="M19 2.5Q19.4 4.6 21.5 5Q19.4 5.4 19 7.5Q18.6 5.4 16.5 5Q18.6 4.6 19 2.5Z"></path></svg>
  {%- when 'step-truck' -%}
    <svg width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2 6.5h11.5v10H2zM13.5 10h4.5l3 3.2v3.3h-7.5"></path><circle cx="6" cy="17.5" r="1.8"></circle><circle cx="17.5" cy="17.5" r="1.8"></circle></svg>
{%- endcase -%}
